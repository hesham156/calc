# Database — use PostgreSQL in production, sqlite for quick local runs
DATABASE_URL=postgresql+psycopg2://attendance:attendance@db:5432/attendance
# DATABASE_URL=sqlite:///./attendance.db

# Uploads
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
MAX_UPLOAD_MB=50

# CORS (frontend origins, comma separated)
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT=120/minute

COMPANY_NAME=My Company
LOG_LEVEL=INFO
